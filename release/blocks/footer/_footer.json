          "condition": {
            "!=": [
              {
                "var": "classes"
              },
              "variant2"
            ]
          }
        },
        {
          "component": "richtext",
          "name": "socialLinks",
          "label": "Red Bar — Social / Extra Links",
          "valueType": "string",
          "condition": {
            "!=": [
              {
                "var": "classes"
              },
              "variant2"
            ]
          }
        }
      ]
    },
