            { "name": "Footer Hero — red band + columns", "value": "footer-hero" },
            { "name": "Footer Simple — columns only", "value": "footer-simple" }
          ]
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "logo",
          "label": "Logo",
          "multi": false,
