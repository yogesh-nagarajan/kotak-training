          "name": "logoAlt",
          "label": "Logo Alt Text"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "cinTitle",
          "label": "CIN Title",
          "condition": {
            "!=": [
              {
                "var": "classes"
              },
              "variant2"
            ]
          }
        },
        {
          "component": "textarea",
          "valueType": "string",
          "name": "cinSubtitle",
          "label": "CIN Subtitle",
          "condition": {
            "!=": [
              {
                "var": "classes"
              },
              "variant2"
            ]
          }
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "cinBackground",
