          "valueType": "string",
          "value": "variant1",
          "description": "Variant 1 includes CIN and the red legal bar. Variant 2 is the link columns only.",
          "options": [
            {
              "name": "Variant 1 — full (CIN + red bar)",
              "value": "variant1"
            },
            {
              "name": "Variant 2 — inner columns only",
              "value": "variant2"
            }
          ]
        },
        {
          "component": "reference",
